# ==============================================================================
# AegisOps Environment Configuration (Template)
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS.
# ==============================================================================

# Node.js API Service
NODE_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PYTHON_SERVICE_URL=http://python-service:5000

# Python Service
PYTHON_ENV=development
PYTHON_SERVICE_PORT=5000
PYTHON_SERVICE_HOST=0.0.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,python-service,api

# Frontend
VITE_API_BASE_URL=http://localhost:8000
PORT=3000

# Security Policy Engine Settings
AEGISOPS_POLICY_STRICT=false
AEGISOPS_FAIL_ON_SEVERITY=HIGH
AEGISOPS_REPORTS_DIR=./reports
